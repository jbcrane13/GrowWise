+            case .medium: policyKey = "medium"
+            case .long: policyKey = "long"
+            case .custom: policyKey = "custom"
+            }
+            entriesByPolicy[policyKey, default: 0] += 1
+
+            if oldestTimestamp == nil || entry.timestamp < oldestTimestamp! {
