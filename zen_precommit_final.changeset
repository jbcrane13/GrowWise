+    /// Get detailed cache statistics
+    public func getDetailedStats() -> CacheStatistics {
+        var entriesByPolicy: [String: Int] = [:]
+        var oldestTimestamp: Date?
+        var newestTimestamp: Date?
+
+        for entry in cache.values {
+            let policyKey: String
+            switch entry.policy {
