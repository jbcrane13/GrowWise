+
+public enum MemoryPressureLevel: Int, Sendable, Comparable, CustomStringConvertible {
+    case normal = 0
+    case warning = 1
+    case critical = 2
+    case urgent = 3
+
+    public static func < (lhs: MemoryPressureLevel, rhs: MemoryPressureLevel) -> Bool {
