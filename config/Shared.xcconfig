// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Cultivation
PRODUCT_DISPLAY_NAME = Cultivation
PRODUCT_BUNDLE_IDENTIFIER = com.growwiser.app
MARKETING_VERSION = 1.1
CURRENT_PROJECT_VERSION = 1777746192

// MARKETING_VERSION

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = portrait landscape-left landscape-right
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = portrait landscape-left landscape-right portrait-upside-down
PERENUAL_API_KEY =
INFOPLIST_KEY_PERENUAL_API_KEY = $(PERENUAL_API_KEY)

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/GrowWise.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/GrowWise.entitlements
