<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	GROWWISE ENTITLEMENTS — ADD CAPABILITIES HERE AS THEY ARE ENABLED IN THE APP ID

	App ID: com.growwiser.app | Team: 32XZRDTGK3

	To enable a capability:
	1. Go to developer.apple.com → Certificates, Identifiers & Profiles → Identifiers
	2. Find com.growwiser.app and enable the capability
	3. Uncomment the corresponding block below
	4. Xcode automatic signing will regenerate the provisioning profile

	Push Notifications (aps-environment):
	<key>aps-environment</key>
	<string>development</string>

	CloudKit (requires container iCloud.com.growwiser.app to be created first):
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.growwiser.app</string>
	</array>

	App Groups (requires group.com.growwiser.app to be created first):
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.growwiser.app</string>
	</array>

	Background Modes (background-processing, background-fetch):
	<key>com.apple.developer.background-modes</key>
	<array>
		<string>background-processing</string>
		<string>background-fetch</string>
	</array>

	Location Background (requires background location mode in Info.plist too):
	<key>com.apple.developer.location.corelocation.background</key>
	<true/>
	-->
</dict>
</plist>
