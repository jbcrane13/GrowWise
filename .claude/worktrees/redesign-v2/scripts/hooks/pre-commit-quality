#!/usr/bin/env sh
# GrowWise quality pre-commit hook
# Runs: large file check → SwiftLint → SwiftFormat on staged files.
# Install via: ./scripts/install-hooks.sh

set -e

# --- Large file detection ---
# Block files over 2MB and Swift files over 800 lines from being committed.
MAX_FILE_SIZE=2097152  # 2MB in bytes
MAX_SWIFT_LINES=800

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
    OVERSIZED=""
    OVERLONG=""
    for f in $STAGED_FILES; do
        [ -f "$f" ] || continue
        SIZE=$(wc -c < "$f" | tr -d ' ')
        if [ "$SIZE" -gt "$MAX_FILE_SIZE" ]; then
            HUMAN_SIZE=$(echo "$SIZE" | awk '{ printf "%.1fMB", $1/1048576 }')
            OVERSIZED="$OVERSIZED\n  $f ($HUMAN_SIZE)"
        fi
        case "$f" in *.swift)
            LINES=$(wc -l < "$f" | tr -d ' ')
            if [ "$LINES" -gt "$MAX_SWIFT_LINES" ]; then
                OVERLONG="$OVERLONG\n  $f ($LINES lines)"
            fi
        ;; esac
    done

    if [ -n "$OVERSIZED" ]; then
        echo "ERROR: Staged files exceed 2MB size limit:$OVERSIZED"
        echo ""
        echo "Consider using Git LFS for binary assets or splitting large files."
        exit 1
    fi
    if [ -n "$OVERLONG" ]; then
        echo "WARNING: Swift files exceed $MAX_SWIFT_LINES lines:$OVERLONG"
        echo "Consider splitting into smaller, focused modules."
    fi
fi

# Only run lint/format if there are staged Swift files
STAGED_SWIFT=$(echo "$STAGED_FILES" | grep '\.swift$' || true)
if [ -z "$STAGED_SWIFT" ]; then
    exit 0
fi

echo "Running quality checks on staged Swift files..."

# SwiftLint — enforce code style rules
if command -v swiftlint >/dev/null 2>&1; then
    echo "  Running SwiftLint..."
    swiftlint lint --config .swiftlint.yml || {
        echo ""
        echo "SwiftLint found errors. Fix them or run:"
        echo "  swiftlint lint --fix --config .swiftlint.yml"
        exit 1
    }
else
    echo "WARNING: swiftlint not found (brew install swiftlint)"
fi

# SwiftFormat — verify formatting
if command -v swiftformat >/dev/null 2>&1; then
    echo "  Running SwiftFormat (lint mode)..."
    swiftformat --lint --config .swiftformat GrowWisePackage/Sources GrowWise 2>&1 || {
        echo ""
        echo "SwiftFormat found formatting issues. Auto-fix with:"
        echo "  swiftformat --config .swiftformat GrowWisePackage/Sources GrowWise"
        exit 1
    }
else
    echo "WARNING: swiftformat not found (brew install swiftformat)"
fi

echo "Quality checks passed."
