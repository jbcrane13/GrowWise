# SwiftFormat configuration for GrowWise iOS project
# Swift 6, iOS 17+

--swiftversion 6.0
--indent 4
--indent-case false
--trim-whitespace always
--linebreaks lf
--semicolons never
--trailing-commas always
--exponent-case lowercase
--hex-literal-case uppercase
--binary-grouping 4,8
--octal-grouping 4,8
--hex-grouping 4,8
--pattern-let inline
--self init-only
--self-required
--strip-unused-args closure-only
--closing-paren balanced
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--wrap-type-aliases preserve
--wrap-ternary default
--func-attributes preserve
--type-attributes preserve
--stored-var-attributes preserve
--xcode-indentation disabled
--inferred-types always
--organize-types class,struct,enum,extension,protocol
--extension-acl on-extension
--mark-types always
--mark-extensions always
--ifdef no-indent

--disable isEmpty,redundantSelf

# Exclude generated files and dependencies
--exclude build,.build,Pods,GrowWisePackage/Sources/GrowWiseServices/CompanionPlantingData.json
