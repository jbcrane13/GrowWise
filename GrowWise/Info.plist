<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<!-- Required by SwiftData CloudKit sync to schedule background import/export tasks.
	     Without these identifiers, NSPersistentCloudKitContainer cannot submit BGTask
	     requests and repeatedly fails with BGSystemTaskSchedulerErrorDomain Code=8. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.apple.coredata.cloudkit.private.push</string>
	</array>
</dict>
</plist>
