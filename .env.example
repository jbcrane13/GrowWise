# GrowWise Environment Variables
#
# This iOS app runs on-device and does NOT use server-side environment variables.
# All configuration is embedded in the Xcode project, Info.plist, or managed
# by the Xcode signing & capabilities system.
#
# The following documents required Apple developer account setup and
# optional development tooling configuration.

# =============================================================================
# APPLE DEVELOPER ACCOUNT (Required for running on device / CloudKit)
# =============================================================================

# Your Apple Developer Team ID (found at developer.apple.com > Membership)
# Used in: GrowWise.xcodeproj signing settings
APPLE_TEAM_ID=

# CloudKit Container identifier (format: iCloud.com.yourcompany.growwise)
# Found in: Xcode > Signing & Capabilities > iCloud > CloudKit containers
CLOUDKIT_CONTAINER_ID=

# =============================================================================
# XCODE BUILD SETTINGS (Development tooling)
# =============================================================================

# Simulator name for running tests (used in xcodebuild -destination)
# Example: iPhone 16, iPhone 15 Pro
TEST_SIMULATOR_NAME=iPhone 16

# Xcode version to use (if multiple installed)
# DEVELOPER_DIR=/Applications/Xcode_16.app/Contents/Developer

# =============================================================================
# CI SECRETS (GitHub Actions — set in repository Settings > Secrets)
# =============================================================================

# These are set in GitHub repository secrets, NOT in this file.
# Reference only — do not add real values here.
#
# MATCH_PASSWORD          — fastlane match encryption password (if used)
# APP_STORE_CONNECT_KEY   — App Store Connect API key (if used)
# SLACK_WEBHOOK_URL       — For deployment notifications (if configured)

# =============================================================================
# NOTES
# =============================================================================
#
# No runtime secrets are required for local development.
# The app uses the iOS Keychain for all sensitive data storage.
# Biometric auth (Face ID/Touch ID) uses the Secure Enclave directly.
# No external API keys are required for core functionality.
